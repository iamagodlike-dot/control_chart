# ─── Пример настроек. Реальные значения лежат в файле .env (он не попадает в git) ───

# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...

# Проект Firebase
FIREBASE_PROJECT_ID=gannt-9b15d

# Путь к ключу доступа к базе (сервисный аккаунт Firebase, файл JSON)
SERVICE_ACCOUNT_PATH=./service-account.json

# Адрес сайта, откуда бот берёт фото машин (nginx раздаёт их по /uploads/).
# По умолчанию https://app.academyauto.ru — менять только если сменится домен.
PHOTOS_BASE_URL=https://app.academyauto.ru

# Во сколько присылать утреннюю сводку управляющим и в каком часовом поясе.
# ВНИМАНИЕ: пояс здесь МОСКОВСКИЙ (исторически), т.е. 10:00 = 14:00 по Красноярску.
SUMMARY_TIME=10:00
SUMMARY_TZ=Europe/Moscow

# Вечернее напоминание управляющим (в том же поясе, что SUMMARY_TZ)
REMINDER_TIME=18:00

# Сводка учредителю «Состояние ремонтов»: новые авто, согласования,
# укомплектованность по запчастям, счета к оплате. Пояс СВОЙ, по умолчанию
# красноярский — 10:00 здесь = 06:00 по Москве. Не перепутайте с SUMMARY_TZ.
FOUNDER_DIGEST_TIME=10:00
FOUNDER_DIGEST_TZ=Asia/Krasnoyarsk

# Telegram ID управляющих (через запятую) — видят финансы и получают утреннюю сводку
MANAGERS=

# Telegram ID остальных сотрудников (через запятую) — видят машины и статусы, без финансов
STAFF=

# Telegram ID учредителей (через запятую) — получают ежедневную сводку «Состояние
# ремонтов» (см. FOUNDER_DIGEST_TIME) и мгновенный пуш при выставлении счёта
# поставщика; отмечают оплату кнопкой «Оплачено» → позиции уходят в «Заказано».
FOUNDERS=

# Telegram ID запчастистов (через запятую) — роль «Запчастист» на сайте. Получают
# пуш «Нужно заказать» (в машине ПОД РЕМОНТОМ появилась позиция «Требуется») и
# «Счёт оплачен» (учредитель оплатил счёт поставщика → позиции ушли в «Заказано»).
# В разделе «Запчасти» видят поставщика и закупку, но не выручку/прибыль.
PARTSMEN=

# Telegram ID мастеров-приёмщиков (через запятую) — роль «Мастер-приёмщик» на сайте.
# Получают утреннюю сводку «Дефектовка»: кто приезжает сегодня, кому позвонить
# (дефектовка завтра), кто не приехал и кто ещё ждёт приглашения. Денег не видят.
RECEPTIONISTS=

# Во сколько и в каком поясе слать сводку «Дефектовка» (по умолчанию 8:30 Крск —
# приёмщик начинает день со звонков, список нужен ему до открытия сервиса).
# В пустой день сводка не отправляется.
INTAKE_DIGEST_TIME=08:30
INTAKE_DIGEST_TZ=Asia/Krasnoyarsk

# ─── Почта: ежедневный разбор «итог дня» управляющим ───
# Доступ к ящику Яндекса по IMAP (только чтение). Пароль — «ПАРОЛЬ ПРИЛОЖЕНИЯ»
# (не основной от аккаунта!): id.yandex.ru → Пароли приложений → тип «Почта».
# Нужна включённая двухфакторная аутентификация. Пусто → разбор почты не включается.
MAIL_USER=autoakadem@yandex.ru
MAIL_PASSWORD=
MAIL_HOST=imap.yandex.ru

# Во сколько и в каком поясе слать разбор (по умолчанию 18:00 Крск).
MAIL_DIGEST_TIME=18:00
MAIL_DIGEST_TZ=Asia/Krasnoyarsk

# Кому слать разбор почты (Telegram ID через запятую). Пусто = всем управляющим.
# Например, только управляющему, без учредителя.
MAIL_DIGEST_TO=

# ─── Пример настроек. Реальные значения лежат в файле .env (он не попадает в git) ───

# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...

# Проект Firebase
FIREBASE_PROJECT_ID=gannt-9b15d

# Путь к ключу доступа к базе (сервисный аккаунт Firebase, файл JSON)
SERVICE_ACCOUNT_PATH=./service-account.json

# Адрес сайта, откуда бот берёт фото машин (nginx раздаёт их по /uploads/).
# По умолчанию https://app.academyauto.ru — менять только если сменится домен.
PHOTOS_BASE_URL=https://app.academyauto.ru

# Во сколько присылать утреннюю сводку и в каком часовом поясе
SUMMARY_TIME=10:00
SUMMARY_TZ=Europe/Moscow

# Telegram ID управляющих (через запятую) — видят финансы и получают утреннюю сводку
MANAGERS=

# Telegram ID остальных сотрудников (через запятую) — видят машины и статусы, без финансов
STAFF=

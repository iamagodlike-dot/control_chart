rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Кто есть кто ───────────────────────────────────────────────────────
    // Роли лежат в коллекции users, ключ документа = email в нижнем регистре
    // (см. normEmail в client/src/api.js). Здесь мы читаем роль вызывающего по
    // его email из токена входа и решаем, что ему можно.
    function signedIn() { return request.auth != null; }
    function meRef() {
      return /databases/$(database)/documents/users/$(request.auth.token.email.lower());
    }
    function hasProfile() { return signedIn() && exists(meRef()); }
    function me() { return get(meRef()).data; }

    // Управленец: есть запись с ролью owner и доступ не отключён.
    function isOwner() { return hasProfile() && me().role == 'owner' && me().active != false; }
    // Учредитель: инвестор, оплачивает счета поставщиков. Активная запись с ролью
    // founder. Права даём точечно (счета поставщиков + флип позиций в jobs через
    // isActive); денежная лента transactions/salaryPayments ему НЕ открыта.
    function isFounder() { return hasProfile() && me().role == 'founder' && me().active != false; }
    // Активный сотрудник: вошёл и не отключён явно. Пока роли ещё никому не
    // назначены (записи нет) — считаем активным, чтобы первый управленец мог
    // войти и всё настроить, никого не заперев.
    function isActive() { return signedIn() && (!hasProfile() || me().active != false); }

    // ─── Рабочие данные: любой активный сотрудник ───────────────────────────
    // Мастеру и экспедитору это нужно для работы (график, склад, запчасти,
    // машины, документы). Поведение как раньше — просто отсекаем отключённых.
    match /posts/{id}            { allow read, write: if isActive(); }
    match /masters/{id}          { allow read, write: if isActive(); }
    match /insurers/{id}         { allow read, write: if isActive(); }
    // Справочник поставщиков запчастей: читают все (подсказки на экране «Запчасти»),
    // а заводит/меняет только управленец — он ведёт этот список в «Настройках».
    match /suppliers/{id}        { allow read: if isActive(); allow write: if isOwner(); }
    match /jobs/{id}             { allow read, write: if isActive(); }
    match /stages/{id}           { allow read, write: if isActive(); }
    // Настройки читают все активные (реквизиты компании нужны для документов и
    // расчётов), а вот настройки телеграм-бота меняет только управленец: там
    // список получателей и расписание рассылок. Отдельного match для settings/bot
    // мало — в Firestore правила складываются (любое разрешившее правило открывает
    // доступ), поэтому исключаем его прямо здесь.
    // botStatus пишет сам бот служебным ключом (правила его не касаются).
    // settings/intake — правила приёмки: какие пункты чек-листа и какие ракурсы
    // съёмки обязательны. Приёмщик обязан их ЧИТАТЬ, но не менять: иначе
    // блокировка «без фото VIN приёмку не закрыть» обходится за два клика в
    // обход интерфейса. Поэтому исключаем и его — правит только управленец.
    match /settings/{id}         { allow read: if isActive();
                                   allow write: if isActive() && id != 'bot' && id != 'botStatus' && id != 'intake'; }
    match /settings/bot          { allow write: if isOwner(); }
    match /settings/intake       { allow write: if isOwner(); }
    match /queue/{id}            { allow read, write: if isActive(); }
    match /cells/{id}            { allow read, write: if isActive(); }
    match /warehouseConfig/{id}  { allow read, write: if isActive(); }
    match /warehouseLog/{id}     { allow read, write: if isActive(); }
    match /orderDocuments/{id}   { allow read, write: if isActive(); }
    // Счётчики автонумерации документов: counters/{тип}-{год} с полем value.
    // Любой активный сотрудник заводит машины и выдаёт документы, поэтому и читает,
    // и увеличивает счётчик. Атомарность самой выдачи держит транзакция в api.js.
    match /counters/{id}         { allow read, write: if isActive(); }

    // ─── Денежная лента: только управленцы ──────────────────────────────────
    // Аренда, зарплаты, налоги, ручные доходы/расходы. Ни один экран линейного
    // сотрудника это не читает, поэтому замок их работу не ломает — но и в обход
    // интерфейса (через консоль браузера) мастер эти данные больше не получит.
    match /transactions/{id}     { allow read, write: if isOwner(); }
    // Выплаты зарплаты мастерам (аванс / расчёт) — только управленец: это деньги.
    match /salaryPayments/{id}   { allow read, write: if isOwner(); }

    // ─── Список доступов ────────────────────────────────────────────────────
    // Читать могут все активные (приложению нужно определить роль вошедшего).
    // Менять — только управленец. Плюс первичная настройка: пока у вошедшего
    // ещё нет своей записи, он может создать РОВНО свою запись управленца —
    // так самый первый владелец заводит себя, не имея пока никаких прав.
    match /users/{id} {
      allow read: if isActive();
      allow write: if isOwner()
        || (signedIn() && !hasProfile()
            && id == request.auth.token.email.lower()
            && request.resource.data.role == 'owner');
    }

    // ─── Траты сотрудников ──────────────────────────────────────────────────
    // Экспедитор вносит свои траты (запчасти за нал, бензин…). Он видит и правит
    // ТОЛЬКО свои записи (created_by = его email); создать чужую нельзя. Управленец
    // видит и правит все. Денежной ленты transactions это не касается — она заперта.
    match /expenses/{id} {
      allow read:          if isOwner() || (isActive() && resource.data.created_by == request.auth.token.email.lower());
      allow create:        if isActive() && request.resource.data.created_by == request.auth.token.email.lower();
      allow update, delete: if isOwner() || (isActive() && resource.data.created_by == request.auth.token.email.lower());
    }

    // ─── Заявки на закупку расходников ───────────────────────────────────────
    // Любой активный сотрудник создаёт заявку (created_by = его email) и видит
    // список — это рабочие данные, как машины и график. Одобрение и отметку
    // «куплено» показывает интерфейс нужным ролям (управленец/экспедитор); сами
    // деньги пишутся в expenses и остаются под её замком «своё или управленец».
    match /purchaseRequests/{id} {
      allow read:           if isActive();
      allow create:         if isActive() && request.resource.data.created_by == request.auth.token.email.lower();
      allow update, delete: if isActive();
    }

    // ─── Счета поставщиков (учредитель оплачивает запчасти) ──────────────────
    // Запчастист собирает позиции в счёт + грузит файл (created_by = его email),
    // учредитель видит неоплаченные и отмечает «Оплачено» (update). Это рабочие
    // данные — читают все активные (запчастист/управленец/учредитель). Отметка
    // оплаты попутно двигает позиции в jobs (флип в «Заказано») — jobs и так под
    // isActive, поэтому учредителю хватает роли founder (она активна). Сам расход
    // в чистую прибыль не пишется (см. computeCashFlow) — задвоения нет.
    // NB: телеграм-бот пишет через служебный ключ (admin SDK) и эти правила обходит;
    // проверка прав для бота — в его коде (ярус FOUNDERS).
    match /supplierInvoices/{id} {
      allow read:           if isActive();
      allow create:         if isActive() && request.resource.data.created_by == request.auth.token.email.lower();
      allow update, delete: if isActive();
    }

    // ─── Задания телеграм-боту ───────────────────────────────────────────────
    // Экран «Настройки → Телеграм-бот» кладёт сюда поручение («проверить связь»,
    // «отправить рассылку сейчас»), бот его выполняет служебным ключом и
    // дописывает результат. Токен Telegram остаётся только на сервере — сайт
    // никому напрямую не пишет. Раз это рассылка людям, доступ только управленцу.
    match /botCommands/{id}      { allow read, write: if isOwner(); }

    match /{document=**} { allow read, write: if false; }
  }
}
